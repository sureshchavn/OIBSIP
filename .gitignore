```gitignore
# Dependencies
node_modules/
vendor/

# Environment variables and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Build and output
dist/
build/
out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# VS Code settings
.vscode/

# IDE files
.idea/

# Temporary files
*.tmp
*.bak
*.swp

# Test and coverage
coverage/
.nyc_output/
